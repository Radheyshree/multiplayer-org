+  /**
+   * Handle pull_request_review_comment — a comment anchored to a line of the diff.
+   *
+   * `payload.comment.path` and `.line` say where; both are surfaced so the
+   * ticket shows "commented on src/foo.ts:42" rather than an unplaced quote.
+   */
+  private async handleReviewCommentEvent(
+    payload: GitHubReviewCommentPayload
+  ): Promise<{ success: boolean; message: string }> {
+    try {
+      if (payload.action !== 'created') {
+        return { success: true, message: `Review comment ${payload.action} acknowledged` };
+      }
+      await prTicketStatusSyncService.recordPRComment({
+        prId: payload.pull_request.number,
+        prUrl: payload.pull_request.html_url,
+        commentId: payload.comment.id,
+        commentText: payload.comment.body || '',
+        authorName: payload.comment.user?.login,
+        commentUrl: payload.comment.html_url,
+        ...(payload.comment.path ? { filePath: payload.comment.path } : {}),
+        ...(payload.comment.line ? { lineNumber: payload.comment.line } : {}),
+      });
+      return { success: true, message: 'Review comment processed successfully' };
+    } catch (error) {
+      logger.error('[GitHub-Webhook] Error handling pull_request_review_comment:', error);
+      return { success: true, message: 'Review comment error acknowledged' };
+    }
+  }
+
+  /**
+   * Handle pull_request_review — approve / request changes / comment summary.
+   *
+   * An approval with no body is still worth recording: "approved" is the fact
+   * the ticket needs, and it is exactly what nobody could see before.
+   */
+  private async handleReviewEvent(
+    payload: GitHubReviewPayload
+  ): Promise<{ success: boolean; message: string }> {
+    try {
+      if (payload.action !== 'submitted') {
+        return { success: true, message: `Review ${payload.action} acknowledged` };
+      }
+      const state = (payload.review.state || '').toLowerCase();
+      const verdict =
+        state === 'approved'
+          ? 'approved this'
+          : state === 'changes_requested'
+            ? 'requested changes'
+            : 'reviewed this';
+      await prTicketStatusSyncService.recordPRComment({
+        prId: payload.pull_request.number,
+        prUrl: payload.pull_request.html_url,
+        commentId: payload.review.id,
+        commentText: payload.review.body ? `${verdict}: ${payload.review.body}` : verdict,
+        authorName: payload.review.user?.login,
+        commentUrl: payload.review.html_url,
+      });
+      return { success: true, message: 'Review processed successfully' };
+    } catch (error) {
+      logger.error('[GitHub-Webhook] Error handling pull_request_review:', error);
+      return { success: true, message: 'Review error acknowledged' };
+    }
+  }
