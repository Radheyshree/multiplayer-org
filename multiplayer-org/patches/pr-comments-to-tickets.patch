--- a/apps/backend/src/services/prTicketStatusSyncService.ts
+++ b/apps/backend/src/services/prTicketStatusSyncService.ts
@@ -511,6 +511,97 @@ export class PRTicketStatusSyncService {
    * Commented out since terminal status check is disabled
    */
 
+  /**
+   * Record a review comment left on a pull request onto the PR's ticket.
+   *
+   * The PR lifecycle already reaches the ticket — opened, merged, declined all
+   * produce a SYSTEM message here. Comments did not, and a comment is where the
+   * actual review conversation happens: "this breaks pagination", "ship it".
+   * Someone reading the ticket saw that a PR existed and never saw a word of
+   * what was said about it, in either Bitbucket or GitHub.
+   *
+   * Deliberately reuses `findTicketForPR` and `resolveUpdatedBy` rather than
+   * repeating them: comment events must attribute to the same person and land
+   * on the same ticket as every other PR event, or the thread reads as two
+   * different integrations.
+   *
+   * Never throws. A webhook that 500s gets retried, and a retried comment is a
+   * duplicate line in someone's ticket.
+   */
+  async recordPRComment(params: {
+    prId: number;
+    prUrl: string;
+    commentId: number | string;
+    commentText: string;
+    authorName?: string;
+    authorEmail?: string;
+    /** Deep link to the comment itself, where the host gives us one. */
+    commentUrl?: string;
+    /** Set for a comment on a specific line of the diff. */
+    filePath?: string;
+    lineNumber?: number;
+  }): Promise<void> {
+    try {
+      const pr = await this.findPR(params.prId, params.prUrl);
+      if (!pr) {
+        logger.debug(`[PR-Ticket-Sync] Comment on untracked PR ${params.prId}, skipping`);
+        return;
+      }
+
+      const ticket = await this.findTicketForPR(pr);
+      if (!ticket?.conversationId) {
+        logger.debug(`[PR-Ticket-Sync] No ticket/conversation for PR ${params.prId}`);
+        return;
+      }
+
+      const senderId = await this.resolveUpdatedBy(params.authorEmail, ticket.workspaceId);
+      const who = params.authorName ?? params.authorEmail ?? 'someone';
+      const where = params.filePath
+        ? ` on <code>${escapeHtml(params.filePath)}</code>${params.lineNumber ? `:${params.lineNumber}` : ''}`
+        : '';
+      const link = params.commentUrl ?? params.prUrl;
+      const body = truncate(stripHtml(params.commentText), 1200);
+      const content =
+        `<a href="${link}" target="_blank" rel="noopener noreferrer">#${params.prId}</a>` +
+        ` — ${escapeHtml(who)} commented${where}:<br><blockquote>${escapeHtml(body)}</blockquote>`;
+
+      await recordTicketTimelineEvent({
+        message: {
+          conversationId: ticket.conversationId,
+          senderId,
+          content,
+          activityType: ActivityType.PR,
+          workspaceId: ticket.workspaceId,
+          extraMetadata: {
+            prWebhook: true,
+            prUrl: params.prUrl,
+            prId: params.prId,
+            // A distinct event so a reader (and any surface rendering this
+            // thread) can tell a comment from a state change.
+            prEvent: 'COMMENTED',
+            prCommentId: String(params.commentId),
+            ...(params.commentUrl ? { prCommentUrl: params.commentUrl } : {}),
+            ...(params.filePath ? { prCommentPath: params.filePath } : {}),
+            ...(params.authorName || params.authorEmail
+              ? {
+                  externalAuthor: {
+                    ...(params.authorName ? { name: params.authorName } : {}),
+                    ...(params.authorEmail ? { email: params.authorEmail } : {}),
+                  },
+                }
+              : {}),
+          },
+        },
+      });
+
+      logger.info(
+        `[PR-Ticket-Sync] Recorded comment ${params.commentId} on PR ${params.prId} to ticket ${ticket.xyneId}`
+      );
+    } catch (error) {
+      logger.error(`[PR-Ticket-Sync] Failed to record PR comment:`, error);
+    }
+  }
+
   /**
    * Send a message to the conversation about PR event
    */
@@ -1003,3 +1094,21 @@ export class PRTicketStatusSyncService {
 
 // Singleton instance for use across the application
 export const prTicketStatusSyncService = new PRTicketStatusSyncService();
+
+/** Comment bodies are markdown from an untrusted host; never inline them raw. */
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
+
+/** Bitbucket sends plain text, GitHub sends markdown; strip any tags either way. */
+function stripHtml(value: string): string {
+  return value.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
+}
+
+function truncate(value: string, max: number): string {
+  return value.length <= max ? value : `${value.slice(0, max - 1)}…`;
+}
